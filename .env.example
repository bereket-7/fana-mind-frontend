# API Configuration
VITE_API_BASE_URL=https://api.fanamind.com
VITE_WS_URL=wss://ws.fanamind.com

# Authentication
VITE_OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
VITE_OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
VITE_OAUTH_GITHUB_CLIENT_ID=your_github_client_id

# Analytics
VITE_ANALYTICS_ENABLED=true
VITE_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true

# CDN Configuration
VITE_CDN_URL=https://cdn.fanamind.com
VITE_UPLOAD_MAX_SIZE=10485760

# Development
VITE_DEBUG_MODE=false
VITE_MOCK_API=false

# Sentry (Error Tracking)
VITE_SENTRY_DSN=your_sentry_dsn
VITE_SENTRY_ENVIRONMENT=development